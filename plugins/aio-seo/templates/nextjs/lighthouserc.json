{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3000",
      "startServerReadyPattern": "Ready|started server|Local:",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/pricing"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "document-title": "error",
        "meta-description": "error",
        "http-status-code": "error",
        "is-crawlable": "error",
        "canonical": "error",
        "hreflang": "warn",
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
